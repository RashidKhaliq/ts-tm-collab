DATABASE_URL=postgresql://user:password@host:5432/thriftsync?sslmode=require
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-long-random-secret
ADMIN_SECRET=replace-with-another-long-random-secret
WORKER_SECRET=replace-with-long-random-secret
SHOPIFY_API_VERSION=2026-07
# When true, business-changing operations on Shopify are enabled. Start with false.
LIVE_WRITES=false
PORT=3000
# Store configuration is managed in the dashboard (encrypted in DB).
# Set 32-byte AES encryption key as 64 hexadecimal characters:
STORE_ENCRYPTION_KEY=replace-with-64-hexadecimal-characters
