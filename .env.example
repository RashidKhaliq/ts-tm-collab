# PostgreSQL Database Connection Strings (Vercel Postgres / Neon Postgres / Direct Postgres)
# Any of POSTGRES_URL, PRISMA_DATABASE_URL, or DATABASE_URL can be set in Vercel ENV
POSTGRES_URL="postgresql://user:password@ep-sample-123456.us-east-1.postgres.vercel-storage.com/verceldb?sslmode=require"
PRISMA_DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-1.postgres.vercel-storage.com/verceldb?sslmode=require"
DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-1.postgres.vercel-storage.com/verceldb?sslmode=require"

# Server Port (Production)
PORT=8000

