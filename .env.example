# Vercel / Neon PostgreSQL connection. DATABASE_URL takes priority.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-strong-password
CRON_SECRET=replace-with-a-strong-random-secret
SHOPIFY_API_VERSION=2026-10
INTERNAL_DISCOUNT_PERCENT=99
ANALYTICS_CACHE_MINUTES=15
# SAFE initial testing. Set true only when ready to make real Shopify modifications.
LIVE_WRITES=false

# STORE_A is the owner of any item with custom.supplier = ZIA
STORE_A_NAME=Store A
STORE_A_URL=owner-store.myshopify.com
STORE_A_SUPPLIER_NAME=Store A
STORE_A_ACCESS_TOKEN=shpca_REAL_ADMIN_API_TOKEN
STORE_A_WEBHOOK_SECRET=REAL_SHOPIFY_WEBHOOK_SIGNING_SECRET
STORE_A_OWNER_EMAIL=owner@example.com
STORE_A_OWNER_PHONE=03000000000
STORE_A_OWNER_ADDRESS1=Street and building
STORE_A_OWNER_CITY=Lahore
STORE_A_OWNER_PROVINCE=Punjab
STORE_A_OWNER_COUNTRY=Pakistan
STORE_A_OWNER_ZIP=54000

# STORE_B also can own items, matching custom.supplier = HAMZA
STORE_B_NAME=Store B
STORE_B_URL=store-b.myshopify.com
STORE_B_SUPPLIER_NAME=Store B
STORE_B_ACCESS_TOKEN=shpca_REAL_ADMIN_API_TOKEN
STORE_B_WEBHOOK_SECRET=REAL_SHOPIFY_WEBHOOK_SIGNING_SECRET
STORE_B_OWNER_EMAIL=reseller@example.com
STORE_B_OWNER_PHONE=03000000000
STORE_B_OWNER_ADDRESS1=Street and building
STORE_B_OWNER_CITY=Lahore
STORE_B_OWNER_PROVINCE=Punjab
STORE_B_OWNER_COUNTRY=Pakistan
STORE_B_OWNER_ZIP=54000

# Add STORE_C_*, STORE_D_*, etc. for any number of stores.
