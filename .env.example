# StockBridge v3 — deploy to Vercel with Framework Preset: Other.
# Set in Vercel Project > Settings > Environment Variables.
# NEVER commit actual tokens or a populated .env file.
DATABASE_URL=postgresql://USER:PASSWORD@NEON_HOST/DATABASE?sslmode=require
ADMIN_USER=admin
ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
CRON_SECRET=REPLACE_WITH_LONG_RANDOM_BEARER_TOKEN
SHOPIFY_API_VERSION=2026-10
LIVE_WRITES=false
DEFAULT_DISCOUNT_PERCENT=99

# Product metafield custom.supplier must contain "Store A" for inventory owned by Store A.
STORE_A_NAME=Store A
STORE_A_URL=store-a.myshopify.com
STORE_A_SUPPLIER_NAME=Store A
STORE_A_ACCESS_TOKEN=REPLACE_WITH_OFFLINE_ADMIN_TOKEN
STORE_A_WEBHOOK_SECRET=REPLACE_WITH_SHOPIFY_WEBHOOK_HMAC_SECRET
STORE_A_OWNER_EMAIL=store-a@example.com
STORE_A_OWNER_ADDRESS1=Store A warehouse
STORE_A_OWNER_CITY=City A
STORE_A_OWNER_COUNTRY=Pakistan

STORE_B_NAME=Store B
STORE_B_URL=store-b.myshopify.com
STORE_B_SUPPLIER_NAME=Store B
STORE_B_ACCESS_TOKEN=REPLACE_WITH_OFFLINE_ADMIN_TOKEN
STORE_B_WEBHOOK_SECRET=REPLACE_WITH_SHOPIFY_WEBHOOK_HMAC_SECRET
STORE_B_OWNER_EMAIL=store-b@example.com
STORE_B_OWNER_ADDRESS1=Store B warehouse
STORE_B_OWNER_CITY=City B
STORE_B_OWNER_COUNTRY=Pakistan

# Additional optional stores (activate by filling all five required fields)
# STORE_C_NAME=Store C
# STORE_C_URL=store-c.myshopify.com
# STORE_C_SUPPLIER_NAME=Store C
# STORE_C_ACCESS_TOKEN=REPLACE_WITH_OFFLINE_ADMIN_TOKEN
# STORE_C_WEBHOOK_SECRET=REPLACE_WITH_SHOPIFY_WEBHOOK_HMAC_SECRET
# STORE_D_NAME=Store D
# STORE_D_URL=store-d.myshopify.com
# STORE_D_SUPPLIER_NAME=Store D
# STORE_D_ACCESS_TOKEN=REPLACE_WITH_OFFLINE_ADMIN_TOKEN
# STORE_D_WEBHOOK_SECRET=REPLACE_WITH_SHOPIFY_WEBHOOK_HMAC_SECRET
